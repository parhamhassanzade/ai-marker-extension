{
  "manifest_version": 3,
  "name": "AI Notebook",
  "version": "2.4.1",
  "description": "Turn AI conversations into chaptered study notebooks with highlights, notes, and PDF export.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "activeTab", "sidePanel", "scripting"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open AI Notebook",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"]
}
