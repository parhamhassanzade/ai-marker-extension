{
  "name": "ai-notebook",
  "version": "3.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "test:e2e": "npm run build && node scripts/smoke.mjs",
    "format": "prettier --write src tests scripts *.ts *.json *.html README.md CHANGELOG.md docs .github/workflows .github/FUNDING.yml",
    "format:check": "prettier --check src tests scripts *.ts *.json *.html README.md CHANGELOG.md docs .github/workflows .github/FUNDING.yml",
    "test:acceptance": "npm run build && node scripts/acceptance.mjs",
    "test:source": "npm run build && node scripts/source-highlights.mjs",
    "test:persian": "npm run build && node scripts/persian-pdf.mjs",
    "test:arc": "npm run build && node scripts/arc-smoke.mjs",
    "test:firefox": "npm run build && node scripts/firefox-smoke.mjs",
    "lint:firefox": "addons-linter build/firefox",
    "package": "npm run build && node scripts/package.mjs",
    "test:ux": "npm run build && node scripts/notebook-ux.mjs",
    "test:support": "npm run build && node scripts/support.mjs",
    "test:claude": "npm run build && node scripts/claude-smoke.mjs"
  },
  "dependencies": {
    "jspdf": "4.2.1",
    "lucide-react": "1.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.3.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "addons-linter": "^10.14.0",
    "fake-indexeddb": "6.2.5",
    "fflate": "0.8.3",
    "geckodriver": "^8.0.0",
    "jsdom": "26.1.0",
    "pdfjs-dist": "5.4.296",
    "prettier": "3.9.10",
    "selenium-webdriver": "^4.51.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
